# ===== Goldflow .gitignore - push only CODE, never data/logs/secrets =====
# Logs
*.log
*.err.log
*.out.log
server_logs/

# Databases (local state - rebuilt on the server from live feed)
*.db
*.db-journal

# Big data / media / caches (the local repo was 2.3 GB because of these)
*.pkl
*.npz
*.dbn
*.pdf
*.mp4
*.mov
*.png
*.jpg
*.jpeg
*.gif
*.zip
*.tar.gz
*.rar
screenshots/
test_shot_*.png

# Python caches
__pycache__/
*.py[cod]
*$py.class
*.pyd
.pytest_cache/
.venv/
venv/
env/

# Project-local folders that must NOT go to the server/GitHub
_backups/
_archive/
questdb_v2/
questdb/
*.dll
*.exe
node_modules/

# Secrets / env (keys live in env vars, never in the repo)
.env
*.key
*_secret*
*credentials*

# OS
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
