[Unit]
Description=GoldFlow Port 8070 - Bloomberg Web Terminal
After=network.target

[Service]
Type=simple
User=goldflow
WorkingDirectory=/opt/goldflow/8080_8070
ExecStart=/opt/goldflow/venv/bin/python xauusd_terminal.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal
SyslogIdentifier=goldflow-8070

[Install]
WantedBy=multi-user.target
